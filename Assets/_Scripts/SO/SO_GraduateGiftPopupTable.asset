  m_Script: {fileID: 11500000, guid: 8235ec72a793b2f4e995ff3918ed09a9, type: 3}
  m_Name: SO_GraduateGiftPopupTable
  m_EditorClassIdentifier: Assembly-CSharp::GraduateGiftPopupTableSO
  _rows:
  - id: itemeffect_01
    rewardType: "\uC601\uAD6C \uC9C0\uC6D0\uAE08 \uC5C5\uADF8\uB808\uC774\uB4DC"
    rewardHeader: "[\uB4E0\uB4E0\uD55C \uD6C4\uBC30\uC758 \uAE30\uBD80]"
    rewardBody: "\"\uC131\uACF5\uD55C \uC878\uC5C5\uC0DD\uC774 \uD300\uC5D0 \uB9E4\uB2EC
      \uD6C4\uC6D0\uAE08\uC744 \uBCF4\uB0B4\uAE30\uB85C \uD588\uC2B5\uB2C8\uB2E4.
      \uC774\uC81C \uC6B4\uC601\uBE44 \uAC71\uC815\uC744 \uB35C\uACA0\uAD70\uC694!\""
  - id: itemeffect_02
    rewardType: "\uC2DC\uC124 \uC5C5\uADF8\uB808\uC774\uB4DC"
    rewardHeader: "[\uBAA8\uAD50\uB97C \uC704\uD55C \uAE30\uC99D]"
    rewardBody: "\"\uAE30\uB85D\uC801\uC778 \uC131\uC801\uC744 \uAC70\uB454 \uC878\uC5C5\uC0DD\uC774
      \uCD5C\uC2E0\uC2DD \uD6C8\uB828 \uC2DC\uC124\uC744 \uAE30\uC99D\uD588\uC2B5\uB2C8\uB2E4.
      \uC2DC\uC124 \uB808\uBCA8\uC774 \uC601\uAD6C \uC0C1\uC2B9\uD569\uB2C8\uB2E4!\""
  - id: itemeffect_03
    rewardType: "\uC7A5\uBE44 \uC5C5\uADF8\uB808\uC774\uB4DC"
    rewardHeader: "[\uBB3C\uB824\uBC1B\uC740 \uD589\uC6B4\uC758 \uC7A5\uBE44]"
    rewardBody: "\"\uC878\uC5C5\uC0DD\uC774 \uD604\uC5ED \uC2DC\uC808 \uC0AC\uC6A9\uD558\uB358
      \uCD5C\uACE0\uAE09 \uC7A5\uBE44\uB97C \uD300\uC5D0 \uB118\uACA8\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC7A5\uBE44 \uC218\uC900\uC774 \uD55C \uB2E8\uACC4 \uC62C\uB77C\uAC11\uB2C8\uB2E4.\""
  - id: itemeffect_04
    rewardType: "\uC989\uC2DC \uD6C4\uC6D0\uAE08 \uC9C0\uAE09"
    rewardHeader: "[\uAE5C\uC9DD \uACA9\uB824\uAE08 \uB3C4\uCC29]"
    rewardBody: "\"\uC878\uC5C5\uC0DD\uC774 \uCCAB \uC6D4\uAE09\uC744 \uCABC\uAC1C
      \uD300\uC5D0 \uAC04\uC2DD\uBE44\uB97C \uBCF4\uB0B4\uC654\uC2B5\uB2C8\uB2E4!
      \uC989\uC2DC \uC790\uAE08\uC774 \uCDA9\uC804\uB429\uB2C8\uB2E4.\""
  - id: itemeffect_05
    rewardType: "\uC804\uCCB4 \uCEE8\uB514\uC158 \uD68C\uBCF5"
    rewardHeader: "[\uC878\uC5C5\uC0DD\uC758 \uAE5C\uC9DD \uBC29\uBB38]"
    rewardBody: "\"\uADF8\uB9AC\uC6B4 \uC5BC\uAD74\uC774 \uCC3E\uC544\uC640 \uD300\uC6D0\uB4E4\uC5D0\uAC8C
      \uD53C\uC790\uC640 \uACA9\uB824\uB97C \uAC74\uB138\uC2B5\uB2C8\uB2E4! \uBAA8\uB450\uC758
      \uC0AC\uAE30\uAC00 \uBA38\uB9AC \uB05D\uAE4C\uC9C0 \uCC28\uC624\uB985\uB2C8\uB2E4.\""
  - id: itemeffect_06
    rewardType: "\uC77C\uC2DC\uC801 \uD6C8\uB828 \uD6A8\uC728 \uC0C1\uC2B9"
    rewardHeader: "[\uC804\uC218\uB41C \uD2B9\uAE09 \uB178\uD558\uC6B0]"
    rewardBody: "\"\uC878\uC5C5\uC0DD\uC774 \uC7A0\uC2DC \uB4E4\uB7EC \uD6C4\uBC30\uB4E4\uC5D0\uAC8C
      \uD2B9\uBCC4 \uAE30\uC220\uC744 \uC804\uC218\uD588\uC2B5\uB2C8\uB2E4. \uB2F9\uBD84\uAC04
      \uD6C8\uB828 \uD6A8\uC728\uC774 \uB300\uD3ED \uC0C1\uC2B9\uD569\uB2C8\uB2E4!\""
  - id: itemeffect_07
    rewardType: "\uD6C8\uB828 \uD6A8\uC728 \uC601\uAD6C \uC0C1\uC2B9"
    rewardHeader: "[\uC804\uC124\uC801\uC778 \uD6C8\uB828 \uB9E4\uB274\uC5BC]"
    rewardBody: "\" \uC878\uC5C5\uC0DD\uC758 \uD6C8\uB828\uBC95\uC774 \uD300\uC758
      \uACF5\uC2DD \uB9E4\uB274\uC5BC\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC774\uC81C
      \uBAA8\uB4E0 \uD6C8\uB828\uC774 \uB354 \uD6A8\uC728\uC801\uC73C\uB85C \uBCC0\uD569\uB2C8\uB2E4!\""
