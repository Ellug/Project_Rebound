  - iD: text_diag_000001_020
    speaker: student
    dialogue: "\uAFC8\uC740 \uD06C\uAC8C \uAC00\uC838\uC57C\uC8E0!"
  - iD: text_diag_000001_021
    speaker: player
    dialogue: "\uC74C! \uC0AC\uB0B4\uAC00 \uAFC8\uC744 \uD06C\uAC8C \uAC00\uC838\uC57C\uC9C0!"
  - iD: text_diag_000001_022
    speaker: player
