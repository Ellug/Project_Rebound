    dialogue: "\uBB50\uB77C\uACE0 \uD558\uB294\uB370?"
  - iD: text_diag_000008_002
    speaker: student
    dialogue: "\uC6B0\uB9AC \uD300 \uADF8\uBB3C\uC740 \uC808\uB300 \uC548 \uD754\uB4E4\uB9B4
      \uAC70\uB798\uC694\u314B\u314B"
