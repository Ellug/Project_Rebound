  - iD: text_diag_000001_029
    speaker: student
    dialogue: "\uBE44\uC2A4\uB4EC\uD574\uC9C8\uD14C\uB2E4."
  - iD: text_diag_000001_030
    speaker: player
    dialogue: "(\uB300\uCDA9 \uB108\uB294 \uC7A1\uD788\uBA74 \uC6B4\uB3D9\uC7A5 100\uBC14\uD034\uB77C\uB294
      \uC120\uACE0)"
  - iD: text_diag_000002_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8.. \uC800 \uC624\uB298 \uD6C8\uB828 \uBABB \uAC00\uC694."
  - iD: text_diag_000002_001
