    dialogue: "\uC798 \uC880 \uD558\uC9C0;;"
  - iD: text_diag_000002_005
    speaker: student
    dialogue: "\uC544 \uC324!! \uC800 \uB098\uB984 \uC5F4\uC2EC\uD788 \uD588\uB2E4\uACE0\uC694!!"
  - iD: text_diag_000002_006
    speaker: player
