  - iD: text_diag_000001_013
    speaker: player
    dialogue: "\u314B\u314B\u314B\u314B\u314B\u314B"
  - iD: text_diag_000001_014
    speaker: student
    dialogue: "\uC544\u314B\u314B\u314B\u314B\u314B\u314B"
  - iD: text_diag_000001_015
    speaker: player
    dialogue: "\uC801\uB2F9\uD788 \uB180\uB2E4 \uB4E4\uC5B4\uAC00\uB77C."
  - iD: text_diag_000001_016
    speaker: player
    dialogue: "\uC0AC\uACE0\uCE58\uC9C0 \uB9D0\uACE0"
  - iD: text_diag_000001_017
    speaker: student
    dialogue: "\uB135!"
  - iD: text_diag_000001_018
    speaker: choice
    dialogue: "\uC6B0\uB9AC \uCE5C\uAD6C\uAC00 \uAFC8\uC774 \uC544\uC8FC \uD06C\uAD6C\uB098!"
  - iD: text_diag_000001_019
    speaker: student
