  - iD: text_diag_000009_012
    speaker: player
    dialogue: "\uC774\uB7F0;;"
  - iD: text_diag_000009_013
    speaker: choice
    dialogue: 0423
  - iD: text_diag_000009_014
    speaker: student
    dialogue: "\uC544\uB2C8 \uAC10\uB3C5\uB2D8;;"
  - iD: text_diag_000009_015
    speaker: student
    dialogue: "\uC548\uB410\uB2E4\uB2C8\uAE4C\uC694?"
  - iD: text_diag_000009_016
    speaker: player
    dialogue: "\uB2E4\uC2DC \uD574\uBD10."
  - iD: text_diag_000009_017
    speaker: student
    dialogue: "....\uC5B4?"
  - iD: text_diag_000009_018
    speaker: player
    dialogue: "'\uC5B4?'\uAC00 \uAC70\uAE30\uC11C \uC65C \uB098\uC624\uB0D0?"
  - iD: text_diag_000009_019
    speaker: player
    dialogue: "\uC790\uBB3C\uC1E0 \uBD80\uC11C\uC9C4\uAC74 \uC544\uB2C8\uC9C0?"
  - iD: text_diag_000009_020
    speaker: student
    dialogue: "\uC5F4\uB838\uC5B4\uC694."
  - iD: text_diag_000009_021
    speaker: player
    dialogue: "\uC790\uBB3C\uC1E0 \uAC70\uAFB8\uB85C \uB4E4\uACE0 \uB3CC\uB838\uB0D0?"
  - iD: text_diag_000009_022
    speaker: student
    dialogue: "\uC557 \uC544\uC544;;"
  - iD: text_diag_000009_023
    speaker: student
    dialogue: "\uC5ED\uC2DC \uAC10\uB3C5\uB2D8"
  - iD: text_diag_000009_024
    speaker: student
    dialogue: "\uC9DC\uB9BF\uD574 \uC0C8\uB85C\uC6CC"
  - iD: text_diag_000009_025
    speaker: student
    dialogue: "\uB3D9\uACBD\uD558\uAC8C \uB3FC"
  - iD: text_diag_000009_026
    speaker: player
    dialogue: "\uC5D0\uD734."
  - iD: text_diag_000010_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8, \uC624\uB298 \uC601\uC5B4\uC324\uC774 \uB18D\uAD6C\uBD80
      \uB2E4 \uB0A8\uC73C\uB798\uC694!"
  - iD: text_diag_000010_001
    speaker: player
    dialogue: "\uC65C? \uB610 \uC0AC\uACE0 \uCCE4\uB0D0?"
  - iD: text_diag_000010_002
    speaker: student
    dialogue: "\uC218\uC5C5 \uC2DC\uAC04\uC5D0 \uACBD\uAE30 \uBD84\uC11D\uD558\uB2E4
      \uACB0\uB824\uC11C\\nNBA \uC601\uC0C1 \uBCF4\uACE0 \uB3C5\uD574 \uD574\uC624\uB798\uC694;;"
  - iD: text_diag_000010_003
    speaker: choice
    dialogue: "\u314B\u314B\u314B\u314B\u314B"
  - iD: text_diag_000010_004
    speaker: player
    dialogue: "\uC804\uC220 \uACF5\uBD80\uB3C4 \uD558\uACE0 \uC88B\uB124."
  - iD: text_diag_000010_005
    speaker: student
    dialogue: "\uD574\uC11D\uC774 \uC548 \uB418\uB294\uB370 \uBB34\uC2A8 \uC804\uC220\uC774\uC5D0\uC694\u3160\u3160\\n\uB2E4
      \uD560 \uB54C \uAE4C\uC9C0 \uC9D1\uC5D0 \uBABB\uAC04\uB2E8 \uB9D0\uC774\uC5D0\uC694;;"
  - iD: text_diag_000010_006
    speaker: player
    dialogue: "\uBAA8\uB974\uBA74 'Pass'\uB77C\uACE0 \uD574. \uB18D\uAD6C \uC6A9\uC5B4\uC796\uC544."
  - iD: text_diag_000010_007
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8 \uC9C4\uC9DC \uB3C4\uC6C0 1\uB3C4 \uC548 \uB3FC;;"
  - iD: text_diag_000010_008
    speaker: choice
    dialogue: "\uC5B4\uB514\uB0D0"
  - iD: text_diag_000010_009
    speaker: student
    dialogue: "\uB124?"
  - iD: text_diag_000010_010
    speaker: player
    dialogue: "\uAC10\uD788 \uB0B4 \uC81C\uC790\uB4E4 \uC5F0\uC2B5\uC2DC\uAC04\uC744
      \uBE8F\uC5B4?"
  - iD: text_diag_000010_011
    speaker: student
    dialogue: "...\uB124?"
  - iD: text_diag_000010_012
    speaker: player
    dialogue: "\uAE30\uB2E4\uB824\uB77C. \uB0B4\uAC00 \uAC04\uB2E4."
  - iD: text_diag_000010_013
    speaker: student
    dialogue: "(\uAC10\uB3D9)"
  - iD: text_diag_000011_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8, \uC624\uB298 \uBC29\uACFC\uD6C4 \uD6C8\uB828 \uB2A6\uC744
      \uAC70 \uAC19\uC544\uC694."
  - iD: text_diag_000011_001
    speaker: player
    dialogue: "\uBB34\uC2A8 \uC77C\uC778\uB370. \uB2E4\uCE5C\uAC74 \uC544\uB2C8\uC9C0?"
  - iD: text_diag_000011_002
    speaker: student
    dialogue: "\uACE0\uC591\uC774\uAC00 \uBC15\uC2A4 \uC548\uC5D0 \uBC84\uB824\uC838
      \uC788\uC5B4\uC11C"
  - iD: text_diag_000011_003
    speaker: student
    dialogue: "\uC6B0\uC120 \uB3D9\uBB3C\uBCD1\uC6D0\uC5D0 \uB9E1\uAE30\uACE0 \uC62C\uAED8\uC694"
  - iD: text_diag_000011_004
    speaker: choice
    dialogue: "\uADF8\uB798, \uC798\uD588\uB2E4."
  - iD: text_diag_000011_005
    speaker: player
    dialogue: "\uC5BC\uB978 \uB9E1\uAE30\uACE0, \uC870\uC2EC\uD574\uC11C \uC640\uB77C."
  - iD: text_diag_000011_006
    speaker: student
    dialogue: "\uB135!"
  - iD: text_diag_000011_007
    speaker: choice
    dialogue: "\uC0AC\uC9C4\uC740"
  - iD: text_diag_000011_008
    speaker: student
    dialogue: "\uB124?"
  - iD: text_diag_000011_009
    speaker: player
    dialogue: "\uC0AC\uC9C4 \uCC0D\uC5B4\uC11C \uBCF4\uC5EC\uC918,"
  - iD: text_diag_000011_010
    speaker: player
    dialogue: "\uC99D\uAC70\uB97C \uC694\uCCAD\uD55C\uB2E4."
  - iD: text_diag_000011_011
    speaker: player
    dialogue: "\uD655\uC2E4\uD55C \uC99D\uAC70\uB97C \uC704\uD574\\n10\uC7A5 \uC774\uC0C1
      \uC62C\uB824\uB77C."
  - iD: text_diag_000011_012
    speaker: student
    dialogue: "...\uC774\uB530 \uC62C\uB9B4\uAED8\uC694."
  - iD: text_diag_000011_013
    speaker: player
    dialogue: "\uC57D\uC18D\uC774\uB2E4?"
  - iD: text_diag_000012_000
    speaker: player
    dialogue: "\uC5B4\uC81C \uACBD\uBE44 \uC120\uC0DD\uB2D8\uAED8 \uB4E4\uC5C8\uB294\uB370."
  - iD: text_diag_000012_001
    speaker: player
    dialogue: "\uC694\uC998 \uD55C \uBC24 \uC911\uC5D0 \uB2F4 \uD0C0\uACE0 \uD559\uAD50\uB85C
      \uB4E4\uC5B4\uC624\uB294 \uB140\uC11D\uC774 \uC788\uB2E4\uB354\uB77C."
  - iD: text_diag_000012_002
    speaker: student
    dialogue: "\uC800 \uC544\uB2CC\uB370\uC694."
  - iD: text_diag_000012_003
    speaker: player
    dialogue: "\uB108\uB77C\uACE0 \uD55C \uC801 \uC5C6\uB294\uB370."
  - iD: text_diag_000012_004
    speaker: student
    dialogue: ...
  - iD: text_diag_000012_005
    speaker: player
    dialogue: "\uB108\uB0D0?"
  - iD: text_diag_000012_006
    speaker: student
    dialogue: "\uB124."
  - iD: text_diag_000012_007
    speaker: player
    dialogue: "\uC65C \uADF8\uB7AC\uC5B4."
  - iD: text_diag_000012_008
    speaker: student
    dialogue: "\uC694\uC998 \uC2E4\uB825\uC774 \uC804\uD600 \uB298\uC9C0 \uC54A\uB294\uAC83
      \uAC19\uC544\uC11C \uADF8\uB7AC\uC5B4\uC694,"
  - iD: text_diag_000012_009
    speaker: choice
    dialogue: "\uD558..."
  - iD: text_diag_000012_010
    speaker: player
    dialogue: "\uC5F0\uC2B5 \uD560\uAC70\uBA74 \uB098\uD55C\uD14C \uBBF8\uB9AC \uB9D0\uD574\uB77C."
  - iD: text_diag_000012_011
    speaker: player
    dialogue: "\uACBD\uBE44 \uC120\uC0DD\uB2D8\uAED8 \uBD80\uD0C1 \uB4DC\uB824\uC57C
      \uD558\uB2C8\uAE4C."
  - iD: text_diag_000012_012
    speaker: student
    dialogue: "\uC9C4\uC9DC\uC694? \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - iD: text_diag_000012_013
    speaker: choice
    dialogue: "\uB2E4\uC74C\uBD80\uD130 \uADF8\uB7EC\uC9C0 \uB9C8\uB77C."
  - iD: text_diag_000012_014
    speaker: player
    dialogue: "\uB2F4 \uB118\uB2E4\uAC00 \uB2E4\uB9AC\uB77C\uB3C4 \uC811\uC9C0\uB974\uBA74"
  - iD: text_diag_000012_015
    speaker: player
    dialogue: "\uB108 \uC55E\uC73C\uB85C \uB18D\uAD6C\uB294 \uC5B4\uB5BB\uAC8C \uD560\uAC74\uB370?"
  - iD: text_diag_000012_016
    speaker: student
    dialogue: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4."
  - iD: text_diag_000012_017
    speaker: player
    dialogue: "\uB108\uB3C4 \uC798\uBABB\uD55C \uAC70 \uC544\uB2C8\uAE4C, \uC774
      \uC774\uC0C1\uC740 \uB9D0 \uC548\uD558\uB9C8."
  - iD: text_diag_000012_018
    speaker: player
    dialogue: "\uBC18\uC131\uBB38 \uC368\uC624\uACE0."
  - iD: text_diag_000012_019
    speaker: student
    dialogue: "\uB124, \uAC10\uB3C5\uB2D8."
  - iD: text_diag_000013_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8!"
  - iD: text_diag_000013_001
    speaker: student
    dialogue: "\uD639\uC2DC \uCCB4\uC721\uAD00 \uBC14\uB2E5\uC5D0\uC11C \uC5D0\uC5B4\uD31F
      \uBABB \uBCF4\uC168\uB098\uC694?"
  - iD: text_diag_000013_002
    speaker: student
    dialogue: "\uC544\uAE4C \uB450\uACE0 \uC628 \uAC83 \uAC19\uC740\uB370...\u3160\u3160"
  - iD: text_diag_000013_003
    speaker: player
    dialogue: "\uC544\uAE4C \uCCAD\uC18C\uD558\uB2E4\uAC00 \uD558\uB098 \uC8FC\uC6CC\uC11C\\n\uBD84\uC2E4\uBB3C
      \uD568\uC5D0 \uB123\uC5B4\uB1A8\uB2E4."
  - iD: text_diag_000013_004
    speaker: student
    dialogue: "\uC67C\uCABD \uB9DE\uB098\uC694?"
  - iD: text_diag_000013_005
    speaker: student
    dialogue: "\uC81C\uBC1C"
  - iD: text_diag_000013_006
    speaker: student
    dialogue: "\uC800 \uADF8\uAC70 \uC5C6\uC73C\uBA74 \uC548\uB3FC\uC694.\\n\uACF5\uBD80\uC5D0
      \uC9D1\uC911 \uBABB\uD55C\uB2E8 \uB9D0\uC774\uC5D0\uC694"
  - iD: text_diag_000013_007
    speaker: choice
    dialogue: "\uACF5\uBD80\uD558\uB294\uB370 \uBB54 \uC5D0\uC5B4\uD31F\uC774\uB0D0"
  - iD: text_diag_000013_008
    speaker: player
    dialogue: "\uC6D0\uB798 \uACF5\uBD80\uD560 \uB550, \uBB50 \uB4E4\uC73C\uBA74\uC11C
      \uD558\uB294\uAC70 \uC544\uB2C8\uB2E4."
  - iD: text_diag_000013_009
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8\uC774 \uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uC54C\uC544\uC694"
  - iD: text_diag_000013_010
    speaker: player
    dialogue: "...\uB098 \uAD50\uC6D0\uC790\uACA9\uC99D \uC788\uAC70\uB4E0?"
  - iD: text_diag_000013_011
    speaker: student
    dialogue: "\uC624 \uC778\uD154\uB9AC."
  - iD: text_diag_000013_012
    speaker: player
    dialogue: "\uD5DB\uC18C\uB9AC\uD558\uC9C0\uB9D0\uACE0, \uC5D0\uC5B4\uD31F\uC774\uB098
      \uAC00\uC838\uAC00\uB77C."
  - iD: text_diag_000013_013
    speaker: student
    dialogue: "\uB124! \uCC3E\uC544\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4!\\n\uBC14\uB85C
      \uAC08\uAED8\uC694!"
  - iD: text_diag_000013_014
    speaker: choice
    dialogue: "\uC751, \uB9DE\uC544."
  - iD: text_diag_000013_015
    speaker: player
    dialogue: "\uC798\uBABB\uD558\uBA74 \uB204\uAC00 \uBC1F\uC744 \uAC83 \uAC19\uC544\uC11C,
      \uB0B4\uAC00 \uC7BD\uC2F8\uAC8C \uC8FC\uC6E0\uC9C0."
  - iD: text_diag_000013_016
    speaker: student
    dialogue: "\uC5ED\uC2DC \uAC10\uB3C5\uB2D8!"
  - iD: text_diag_000013_017
    speaker: student
    dialogue: "\uC0AC\uB791\uD569\uB2C8\uB2E4!"
  - iD: text_diag_000013_018
    speaker: player
    dialogue: "\uC624\uB0D0."
  - iD: text_diag_000014_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8"
  - iD: text_diag_000014_001
    speaker: student
    dialogue: "\uD070\uC77C\uB0AC\uC5B4\uC694"
  - iD: text_diag_000014_002
    speaker: player
    dialogue: "\uC65C"
  - iD: text_diag_000014_003
    speaker: student
    dialogue: "\uC624\uB298 \uC6B4\uB3D9\uC7A5 \uB18D\uAD6C\uB300 \uBCF4\uC218\uD574\uC11C
      \uC0AC\uC6A9 \uBABB\uD55C\uB300\uC694."
  - iD: text_diag_000014_004
    speaker: player
    dialogue: "\uCCB4\uC721\uAD00\uC740 \uBB34\uB108\uC84C\uB0D0."
  - iD: text_diag_000014_005
    speaker: student
    dialogue: "\uBC30\uB4DC\uBBFC\uD134\uBD80\uAC00 \uC774\uBBF8 \uC4F0\uACE0 \uC788\uC5B4\uC694."
  - iD: text_diag_000014_006
    speaker: player
    dialogue: "\uC73C\uC74C..."
  - iD: text_diag_000014_007
    speaker: choice
    dialogue: "\uC88B\uC544."
  - iD: text_diag_000014_008
    speaker: player
    dialogue: "\uC624\uB298\uB9CC \uD2B9\uBCC4 \uD734\uAC00\uB2E4."
  - iD: text_diag_000014_009
    speaker: player
    dialogue: "\uC9D1\uC5D0 \uC77C\uCC0D \uAC00\uC11C \uC26C\uB77C\uACE0 \uC804\uD574\uB77C."
  - iD: text_diag_000014_010
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8 \uB9CC\uC138!"
  - iD: text_diag_000014_011
    speaker: choice
    dialogue: "\uC88B\uC544."
  - iD: text_diag_000014_012
    speaker: player
    dialogue: "\uC804\uC6D0 \uC218\uC5C5 \uB05D\uB098\uACE0 \uBD80\uC2E4\uB85C \uC9D1\uD569\uD558\uB77C\uACE0
      \uC804\uD574\uB77C."
  - iD: text_diag_000014_013
    speaker: player
    dialogue: "\uC624\uB298 \uD6C8\uB828\uC740 \uBE44\uB514\uC624 \uBD84\uC11D\uC73C\uB85C
      \uD6C8\uB828 \uB300\uCCB4\uD55C\uB2E4."
  - iD: text_diag_000014_014
    speaker: student
    dialogue: "\uC544...\\n\uBE44\uB514\uC624\uB294 \uC9C0\uB8E8\uD55C\uB370..."
  - iD: text_diag_000014_015
    speaker: player
    dialogue: "\uC815 \uC2EB\uC73C\uBA74, \uC6B4\uB3D9\uC7A5\uC5D0\uC11C PT\uCCB4\uC870
      1\uBC88\uBD80\uD130"
  - iD: text_diag_000014_016
    speaker: student
    dialogue: "\uC5B4\uB5A4 \uACBD\uAE30\uB97C \uBD84\uC11D\uD560\uC9C0 \uC815\uB9D0
      \uAE30\uB300\uB3FC\uC694!\\n\uC544\uC774 \uC2E0\uB098!"
  - iD: text_diag_000014_017
    speaker: choice
    dialogue: "\uC88B\uC544."
  - iD: text_diag_000014_018
    speaker: player
    dialogue: "\uC624\uB298 \uD6C8\uB828\uC740 \uAD50\uC2E4\uC5D0\uC11C \uC9C4\uD589\uD55C\uB2E4."
  - iD: text_diag_000014_019
    speaker: student
    dialogue: "\uC5B4\uB5BB\uAC8C\uC694?"
  - iD: text_diag_000014_020
    speaker: player
    dialogue: "\uD560 \uAC70\uB294 \uB9CE\uC9C0?"
  - iD: text_diag_000014_021
    speaker: player
    dialogue: "\uC2A4\uCFFC\uD2B8, \uD50C\uB7AD\uD06C, \uD314\uAD7D\uD600\uD3B4\uAE30..."
  - iD: text_diag_000014_022
    speaker: player
    dialogue: "\uBB50 \uBD80\uD130 \uD560\uB798?"
  - iD: text_diag_000014_023
    speaker: student
    dialogue: "\uC0B4\uB824\uC918\uC694."
  - iD: text_diag_000014_024
    speaker: player
    dialogue: "\uC0B4\uB824\uB294 \uB4DC\uB9B4\uAC8C."
  - iD: text_diag_000015_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8. \uADF8, \uB4DC\uB9B4 \uB9D0\uC500\uC774 \uC788\uC5B4\uC694."
  - iD: text_diag_000015_001
    speaker: player
    dialogue: "\uACE0\uBBFC \uC788\uC73C\uBA74 \uC5BC\uB9C8\uB4E0\uC9C0 \uB9D0\uD574\uB77C."
  - iD: text_diag_000015_002
    speaker: student
    dialogue: "\uADF8 \uC0AC\uC18C\uD55C \uACE0\uBBFC\uC778\uB370...."
  - iD: text_diag_000015_003
    speaker: student
    dialogue: "\uC774\uBC88\uC5D0 \uB18D\uAD6C\uD654 \uBC11\uCC3D\uC774 \uB5A8\uC5B4\uC84C\uB294\uB370,\\n\uBD80\uBAA8\uB2D8\uAED8
      \uC0C8\uB85C \uC0AC\uB2EC\uB77C\uACE0 \uD558\uAE30 \uC880 \uC8C4\uC1A1\uD574\uC694"
  - iD: text_diag_000015_004
    speaker: student
    dialogue: "\uD14C\uC774\uD504\uB85C \uC880 \uAC10\uACE0 \uB6F0\uBA74\\n\uD070
      \uC9C0\uC7A5\uC740 \uC5C6\uACA0\uC8E0?"
  - iD: text_diag_000015_005
    speaker: choice
    dialogue: "\uC0AC\uB0B4 \uC790\uC2DD\uC774 \uAD81\uC0C1\uB9DE\uAC8C."
  - iD: text_diag_000015_006
    speaker: player
    dialogue: "\uC624\uB298 \uB05D\uB098\uACE0 \uB0A8\uC544\uB77C."
  - iD: text_diag_000015_007
    speaker: student
    dialogue: "\uC5ED\uC2DC \uC8C4\uC1A1\uD569\uB2C8\uB2E4!"
  - iD: text_diag_000015_008
    speaker: student
    dialogue: "\uC81C\uBC1C \uC9C0\uC625\uC758 \uC154\uD2C0\uB7F0 \uB9CC\uD07C\uC740..."
  - iD: text_diag_000015_009
    speaker: player
    dialogue: "\uC154\uD2C0\uB7F0\uC744 \uC65C \uD574;;"
  - iD: text_diag_000015_010
    speaker: player
    dialogue: "\uB108 \uBC1C \uD06C\uAE30 \uC54C\uC544\uC57C\uD558\uB2C8\uAE4C \uC7A0\uAE50
      \uB0A8\uC73C\uB77C\uACE0."
  - iD: text_diag_000015_011
    speaker: player
    dialogue: "\uC2E0\uBC1C \uC0AC\uB824\uBA74 \uC54C\uC544\uC57C \uD560 \uAC70 \uC544\uB0D0."
  - iD: text_diag_000015_012
    speaker: student
    dialogue: "\uC815\uB9D0\uC694??"
  - iD: text_diag_000015_013
    speaker: player
    dialogue: "\uC2EB\uC74C \uB9D0\uACE0."
  - iD: text_diag_000015_014
    speaker: student
    dialogue: "\uAC10\uC0AC\uD569\uB2C8\uB2E4! \uD3C9\uC0DD \uB530\uB974\uACA0\uC2B5\uB2C8\uB2E4!"
  - iD: text_diag_000015_015
    speaker: choice
    dialogue: "\uADF8\uB7EC\uB2E4 \uB2E4\uCE5C\uB2E4."
  - iD: text_diag_000015_016
    speaker: player
    dialogue: "\uD559\uAD50\uC5D0\uC11C \uC2E0\uBC1C \uC815\uB3C4\uB294 \uC9C0\uC6D0\uD574\uC904
      \uC218 \uC788\uB2E4."
  - iD: text_diag_000015_017
    speaker: player
    dialogue: "\uB0B4\uAC00 \uD559\uAD50\uC5D0 \uAC74\uC758\uD574 \uBCFC \uD14C\uB2C8\uAE4C,\\n\uB0B4\uC77C\uAE4C\uC9C0
      \uC0AC\uC774\uC988 \uBB38\uC790\uB85C \uBCF4\uB0B4\uB77C"
  - iD: text_diag_000015_018
    speaker: student
    dialogue: "\uB124, \uAC10\uB3C5\uB2D8."
  - iD: text_diag_000015_019
    speaker: student
    dialogue: "\uC800 285 \uC2E0\uC5B4\uC694."
  - iD: text_diag_000015_020
    speaker: choice
    dialogue: "\uC73C\uC74C..."
  - iD: text_diag_000015_021
    speaker: player
    dialogue: "\uC608\uC804\uC5D0 \uC2E0\uB358 \uB18D\uAD6C\uD654\uAC00 \uD558\uB098
      \uC788\uB294\uB370,\\n\uD06C\uAE30\uAC00 \uB9DE\uC744\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
  - iD: text_diag_000015_022
    speaker: player
    dialogue: "\uC2E0\uB358 \uAC70\uB77C\uC11C \uC880 \uAEC4\uB044\uB7EC\uC6B8\uAE4C?"
  - iD: text_diag_000015_023
    speaker: student
    dialogue: "\uC544\uB1E8! \uAD6D\uAC00\uB300\uD45C\uAC00 \uC2E0\uB358 \uB808\uC5B4\uD15C\uC778\uB370,
      \uB108\uBB34 \uC88B\uC8E0!"
  - iD: text_diag_000015_024
    speaker: player
    dialogue: "\uADF8\uB7FC \uB2E4\uD589\uC774\uACE0."
  - iD: text_diag_000015_025
    speaker: player
    dialogue: "\uC544, \uB9DE\uB2E4. \uB108 290 \uC2E0\uC73C\uBA74 \uC0AC\uC774\uC988
      \uB9DE\uB0D0?"
  - iD: text_diag_000015_026
    speaker: student
    dialogue: "285 \uC2E0\uC5B4\uC11C \uD06C\uAE30\uB294 \uAD1C\uCC2E\uC544\uC694."
  - iD: text_diag_000015_027
    speaker: student
    dialogue: "\uAC10\uC0AC\uD569\uB2C8\uB2E4, \uAC10\uB3C5\uB2D8."
  - iD: text_diag_000015_028
    speaker: player
    dialogue: "\uADF8\uB798. \uB18D\uAD6C \uC5F4\uC2EC\uD788 \uD574\uB77C."
  - iD: text_diag_000016_000
    speaker: player
    dialogue: "\uC5B4\uB514\uB0D0"
  - iD: text_diag_000016_001
    speaker: student
    dialogue: "\uC800 \uCEE8\uB514\uC158\uC774 \uB108\uBB34 \uC548 \uC88B\uC544\uC11C"
  - iD: text_diag_000016_002
    speaker: student
    dialogue: "\uC624\uB298\uC740 \uC77C\uCC0D \uC9D1\uC5D0 \uAC14\uC5B4\uC694."
  - iD: text_diag_000016_003
    speaker: player
    dialogue: "\uB108 \uAC70\uC9D3\uB9D0\uD558\uBA74 \uBABB\uC368!"
  - iD: text_diag_000016_004
    speaker: player
    dialogue: "\uB108 \uC9C0\uAE08 PC\uBC29\uC774\uC9C0?"
  - iD: text_diag_000016_005
    speaker: student
    dialogue: "\uC544\uB2C8\uC5D0\uC694!"
  - iD: text_diag_000016_006
    speaker: player
    dialogue: "\uBABB \uBBFF\uACA0\uB294\uB370."
  - iD: text_diag_000016_007
    speaker: student
    dialogue: "\uC544\uB2C8 \uAC10\uB3C5\uB2D8!"
  - iD: text_diag_000016_008
    speaker: student
    dialogue: "\uC65C \uC800\uB97C \uBABB \uBBFF\uC73C\uC2DC\uB294 \uAC70\uC5D0\uC694?"
  - iD: text_diag_000016_009
    speaker: student
    dialogue: "\uC800\uD76C\uC758 \uC720\uB300\uAC00, \uACA8\uC6B0 \uC774\uC815\uB3C4\uC600\uB098\uC694?"
  - iD: text_diag_000016_010
    speaker: choice
    dialogue: "\uC751"
  - iD: text_diag_000016_011
    speaker: player
    dialogue: "\uC544\uC774\uB514\uAC00 zx\uD55C\uC6B8\uB369\uD06C\uC655xz\uAC00
      \uBB50\uB0D0?"
  - iD: text_diag_000016_012
    speaker: player
    dialogue: "\uD6C8\uB828 \uBE60\uC9C0\uACE0 \uAC8C\uC784 \uD55C\uB2E4\uACE0,\\n\uC628
      \uB3D9\uB124\uC5D0 \uAD11\uACE0\uD558\uB824\uACE0?"
  - iD: text_diag_000016_013
    speaker: student
    dialogue: "\uC81C \uC544\uC774\uB514\uB97C \uC5B4\uB5BB\uAC8C \uC544\uC138\uC694?"
  - iD: text_diag_000016_014
    speaker: player
    dialogue: "\uB2E4~ \uBC29\uBC95\uC774 \uC788\uC9C0."
  - iD: text_diag_000016_015
    speaker: player
    dialogue: "\uC544\uBB34\uD2BC, \uB10C \uB0B4\uC77C \uC154\uD2C0\uB7F0 100\uD68C
      \uCD94\uAC00\uB2E4."
  - iD: text_diag_000016_016
    speaker: student
    dialogue: "\u3160\u3160"
  - iD: text_diag_000016_017
    speaker: choice
    dialogue: "\uC544\uB2C8, \uADF8\uAC74 \uC544\uB2C8\uACE0..."
  - iD: text_diag_000016_018
    speaker: player
    dialogue: "\uB108\uAC00 \uCCB4\uC721\uAD00 \uC7A0\uADF8\uACE0\\n\uC5F4\uC1E0\uB97C
      \uB4E4\uACE0\uAC00\uC11C"
  - iD: text_diag_000016_019
    speaker: player
    dialogue: "\uC9C0\uAE08 \uB108\uD76C \uC9D1\uC778\uB370."
  - iD: text_diag_000016_020
    speaker: student
    dialogue: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4!"
  - iD: text_diag_000016_021
    speaker: player
    dialogue: "\uADF8\uB7EC\uAC8C \uC81C\uAE4D\uC81C\uAE4D \uC5F0\uB77D\uC744 \uBC1B\uC558\uC5B4\uC57C\uC9C0."
  - iD: text_diag_000016_022
    speaker: player
    dialogue: "\uC774\uBC88\uC5D4 \uB0B4\uAC00 \uD2B9\uBCC4\uD788 \uBD10\uC900\uB2E4."
  - iD: text_diag_000016_023
    speaker: student
    dialogue: "\uC0B4\uB824\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - iD: text_diag_000016_024
    speaker: player
    dialogue: "\uB108\uD76C \uC5B4\uBA38\uB2C8\uAC00 \uC548 \uBD10\uC904\uAC70\uAC70\uB4E0."
  - iD: text_diag_000016_025
    speaker: student
    dialogue: "...\uD568\uAED8\uD574\uC11C \uC601\uAD11\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uAC10\uB3C5\uB2D8."
  - iD: text_diag_000016_026
    speaker: player
    dialogue: "\uADF8\uB798. \uB0B4\uC77C \uBCF4\uC790 ^^"
  - iD: text_diag_000016_027
    speaker: choice
    dialogue: "\uADF8, \uADF8\uCE58\uB9CC..."
  - iD: text_diag_000016_028
    speaker: player
    dialogue: "\uC774\uB807\uAC8C\uB77C\uB3C4 \uD558\uC9C0 \uC54A\uC73C\uBA74..."
  - iD: text_diag_000016_029
    speaker: player
    dialogue: "\uB0B4\uAC00 \uC9C0\uAE08 \uB2C8 \uB4A4\uC5D0 \uC788\uB294\uC9C0\uB3C4
      \uBAA8\uB974\uB294\uAC78."
  - iD: text_diag_000016_030
    speaker: student
    dialogue: "\uC5D1"
  - iD: text_diag_000016_031
    speaker: student
    dialogue: "\uC0B4\u3139"
  - iD: text_diag_000017_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8, \uC9C8\uBB38 \uC788\uC2B5\uB2C8\uB2E4."
  - iD: text_diag_000017_001
    speaker: player
    dialogue: "\uBB54\uB370?"
  - iD: text_diag_000017_002
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8\uC740 '\uC7AC\uB2A5'\uC774\uB791 '\uB178\uB825'
      \uC911\uC5D0\\n\uBB50\uAC00 \uB354 \uC911\uC694\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC138\uC694?"
  - iD: text_diag_000017_003
    speaker: choice
    dialogue: "\uB2F9\uC5F0\uD788 \uB178\uB825\uC774\uC9C0."
  - iD: text_diag_000017_004
    speaker: player
    dialogue: "\uC7AC\uB2A5\uC740 \uADF8 \uB178\uB825\uC744 \uC5B4\uB514\uAE4C\uC9C0
      \uB04C\uACE0 \uAC08\uC9C0 \uACB0\uC815\uD560 \uBFD0\uC774\uB2C8\uAE4C."
  - iD: text_diag_000017_005
    speaker: student
    dialogue: "...\uB0C9\uC815\uD558\uC2DC\uB124\uC694."
  - iD: text_diag_000017_006
    speaker: student
    dialogue: "\uADFC\uB370 \uADF8\uAC8C \uB9DE\uB294 \uB9D0 \uAC19\uC544\uC694."
  - iD: text_diag_000017_007
    speaker: player
    dialogue: "\uADF8\uCE58?"
  - iD: text_diag_000017_008
    speaker: player
    dialogue: "\uADF8\uB7EC\uB2C8\uAE4C, \uC5F4\uC2EC\uD788 \uD574\uB77C."
  - iD: text_diag_000017_009
    speaker: student
    dialogue: "\uB124. \uB05D\uAE4C\uC9C0 \uB178\uB825\uD574 \uBCFC\uAED8\uC694."
  - iD: text_diag_000017_010
    speaker: choice
    dialogue: "\uACB0\uAD6D\uC740 \uC7AC\uB2A5\uC774\uC9C0?"
  - iD: text_diag_000017_011
    speaker: player
    dialogue: "\uD558\uC9C0\uB9CC \uB178\uB825 \uC5C6\uB294 \uC7AC\uB2A5\uC740 \uAE08\uBC29
      \uBC14\uB2E5\uB098."
  - iD: text_diag_000017_012
    speaker: player
    dialogue: "\uADF8\uB7EC\uB2C8\uAE4C, \uD56D\uC0C1 \uCDA9\uC2E4\uD558\uAC8C \uD6C8\uB828\uC5D0
      \uC784\uD558\uB3C4\uB85D."
  - iD: text_diag_000017_013
    speaker: student
    dialogue: "\uC5ED\uC2DC \uAC10\uB3C5\uB2D8\uB2E4\uC6B4 \uB2F5\uBCC0\uC774\uB124\uC694.
      \uD798\uC774 \uC880 \uB098\uC694"
  - iD: text_diag_000017_014
    speaker: player
    dialogue: "\uBED4\uD55C \uB9D0 \uAC19\uC9C0\uB9CC, \uADF8\uAC8C \uC815\uB2F5\uC774\uB2C8\uAE4C."
  - iD: text_diag_000017_015
    speaker: player
    dialogue: "\uB108\uAC00 \uC131\uC2E4\uD788 \uB178\uB825\uD55C \uB9CC\uD07C,\\n\uACB0\uACFC\uB85C\uC11C
      \uC99D\uBA85\uB420\uAC70\uB2E4."
  - iD: text_diag_000017_016
    speaker: student
    dialogue: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC624\uB298 \uC29B \uC5F0\uC2B5 100\uAC1C
      \uB354 \uD558\uACE0 \uAC08\uAC8C\uC694!"
  - iD: text_diag_000017_017
    speaker: choice
    dialogue: "\uAC11\uC790\uAE30 \uC65C?"
  - iD: text_diag_000017_018
    speaker: player
    dialogue: "\uBB34\uC2A8 \uC77C \uC788\uC5C8\uB0D0?"
  - iD: text_diag_000017_019
    speaker: student
    dialogue: "\uC544\uB1E8, \uADF8\uB0E5... \\n\uC5B4\uC81C \uBCF8 \uB9CC\uD654\uCC45
      \uB300\uC0AC\uAC00 \uC0DD\uAC01\uB098\uC11C\uC694."
  - iD: text_diag_000017_020
    speaker: player
    dialogue: "\uC2F1\uAC70\uC6B4 \uC18C\uB9AC \uB9D0\uACE0 \uD6C8\uB828\uC5D0 \uC9D1\uC911\uD574\uB77C."
  - iD: text_diag_000017_021
    speaker: player
    dialogue: "\uC7A1\uC0DD\uAC01\uC740 \uBAB8 \uAD74\uB9AC\uBA74 \uC0AC\uB77C\uC9C4\uB2E4."
  - iD: text_diag_000017_022
    speaker: student
    dialogue: "\uC73D, \uB4E4\uCF30\uB124\uC694."
  - iD: text_diag_000017_023
    speaker: student
    dialogue: "\uBC14\uB85C \uC5F0\uC2B5\uD558\uB7EC \uAC00\uBCF4\uACA0\uC2B5\uB2C8\uB2E4.!"
  - iD: text_diag_000018_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8!\\n\uADF8\uAC70 \uC544\uC138\uC694?"
  - iD: text_diag_000018_001
    speaker: player
    dialogue: "\uBB54\uB370"
  - iD: text_diag_000018_002
    speaker: student
    dialogue: "\uB9D0 \uB05D\uC5D0 '\uB0D0'\uAC00 \uBD99\uC73C\uBA74 \uADC0\uC5FD\uAC8C
      \uB4E4\uB9B0\uB300\uC694!"
  - iD: text_diag_000018_003
    speaker: player
    dialogue: "\uADF8\uB807\uB0D0?"
  - iD: text_diag_000018_004
    speaker: player
    dialogue: "\uC9C0\uAE08 \uADC0\uC5FD\uB0D0?"
  - iD: text_diag_000018_005
    speaker: player
    dialogue: "\uC65C \uB2F5\uC744 \uC548\uD558\uB0D0?"
  - iD: text_diag_000018_006
    speaker: player
    dialogue: "\uC6C3\uAE30\uB0D0?"
  - iD: text_diag_000018_007
    speaker: player
    dialogue: "\uB2F5\uC7A5 \uC548\uD558\uB0D0?"
  - iD: text_diag_000018_008
    speaker: student
    dialogue: "...\uC5ED\uC2DC \uC778\uD130\uB137\uC740 \uBBFF\uC744 \uAC8C \uBABB\uB418\uB294
      \uAC83 \uAC19\uC544\uC694."
  - iD: text_diag_000019_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8,\\n\uD639\uC2DC \uADF8 \uC18C\uBB38 \uB4E4\uC73C\uC168\uC5B4\uC694?"
  - iD: text_diag_000019_001
    speaker: player
    dialogue: "\uC18C\uBB38?"
  - iD: text_diag_000019_002
    speaker: player
    dialogue: "\uBB34\uC2A8 \uC18C\uBB38?"
  - iD: text_diag_000019_003
    speaker: student
    dialogue: "\uC800\uD76C \uD300\uC5D0 \uB300\uD574\uC11C, \uC774\uC0C1\uD55C \uC774\uC57C\uAE30\uAC00
      \uB3CC\uACE0 \uC788\uB098 \uBD10\uC694."
  - iD: text_diag_000019_004
    speaker: student
    dialogue: "\uC790\uC138\uD55C \uAC74 \uC800\uB3C4 \uC798 \uBAA8\uB974\uACA0\uB294\uB370,\\n
      \uC560\uB4E4 \uD45C\uC815\uC774 \uC548 \uC88B\uB354\uB77C\uACE0\uC694."
  - iD: text_diag_000019_005
    speaker: choice
    dialogue: "\uADFC\uAC70 \uC5C6\uB294 \uC18C\uBB38\uC5D0 \uD718\uB458\uB9AC\uC9C0
      \uB9C8\uB77C."
  - iD: text_diag_000019_006
    speaker: player
    dialogue: "\uB108\uD76C\uB294 \uC5F0\uC2B5\uC5D0\uB9CC \uC9D1\uC911\uD558\uBA74
      \uB3FC."
  - iD: text_diag_000019_007
    speaker: player
    dialogue: "\uCD9C\uCC98\uB3C4 \uBAA8\uB974\uB294 \uC18C\uBB38\uC5D0 \uC2E0\uACBD
      \uC4F8 \uC2DC\uAC04\uC5D0,\\n\uC29B \uC5F0\uC2B5 \uD55C \uBC88\uC774\uB77C\uB3C4
      \uB354 \uD574\uB77C."
  - iD: text_diag_000019_008
    speaker: student
    dialogue: "\uB124! \uC7A1\uC0DD\uAC01\uC740 \uBC84\uB9AC\uACE0,\\n\uD6C8\uB828\uC5D0
      \uC9D1\uC911\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  - iD: text_diag_000019_009
    speaker: player
    dialogue: "\uC88B\uC740 \uC790\uC138\uB2E4. \uB0B4\uC77C \uBCF4\uC790."
  - iD: text_diag_000019_010
    speaker: choice
    dialogue: "\uB204\uAC00 \uADF8\uB7F0 \uC18C\uB9AC\uB97C \uD574?"
  - iD: text_diag_000019_011
    speaker: player
    dialogue: "\uB0B4\uAC00 \uC9C1\uC811 \uD655\uC778\uD574\uBCF4\uB9C8."
  - iD: text_diag_000019_012
    speaker: student
    dialogue: "\uC624...\uAC10\uB3C5\uB2D8 \uCD9C\uB3D9\uD558\uB098\uC694?"
  - iD: text_diag_000019_013
    speaker: player
    dialogue: "\uD300 \uBD84\uC704\uAE30 \uD574\uCE58\uB294 \uC77C\uC740\\n\uADF8\uB0E5
      \uB118\uC5B4\uAC08 \uC218 \uC5C6\uC9C0."
  - iD: text_diag_000019_014
    speaker: student
    dialogue: "\uC800\uB3C4 \uB354 \uC54C\uC544\uBCFC\uAED8\uC694, \uAC10\uB3C5\uB2D8."
  - iD: text_diag_000019_015
    speaker: player
    dialogue: "\uADF8\uB798, \uBD80\uD0C1\uD558\uB9C8."
  - iD: text_diag_000020_000
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8, \uC8FC\uBB34\uC138\uC694?"
  - iD: text_diag_000020_001
    speaker: player
    dialogue: "\uC65C"
  - iD: text_diag_000020_002
    speaker: student
    dialogue: "\uC800 \uC9C0\uAE08 \uC57C\uC790\uC2E4\uC778\uB370..."
  - iD: text_diag_000020_003
    speaker: student
    dialogue: "\uCC3D \uBC16\uC73C\uB85C \uCCB4\uC721\uAD00 \uBD88 \uCF1C\uC9C4\uAC70
      \uBCF4\uB2C8\uAE4C \uBBF8\uCE58\uACA0\uC5B4\uC694."
  - iD: text_diag_000020_004
    speaker: player
    dialogue: "\uB098 \uD1F4\uADFC\uD588\uB294\uB370."
  - iD: text_diag_000020_005
    speaker: student
    dialogue: "\uC624\uB298 \uB2F9\uC9C1\uC774\uC2DC\uC796\uC544\uC694."
  - iD: text_diag_000020_006
    speaker: player
    dialogue: "...\uADF8\uB798\uC11C. \uBB50 \uC5B4\uB5BB\uAC8C \uD574\uC904\uAE4C."
  - iD: text_diag_000020_007
    speaker: student
    dialogue: "\uB531 30\uBD84\uB9CC, 30\uBD84\uB9CC \uC29B \uC5F0\uC2B5\uD558\uACE0
      \uC624\uBA74 \uC548 \uB420\uAE4C\uC694?"
  - iD: text_diag_000020_008
    speaker: student
    dialogue: "\uC81C\uBC1C\uC694! \uAC10\uB3C5\uB2D8\uC774 \uBD88\uB800\uB2E4\uACE0
      \uD574\uC8FC\uC2DC\uBA74 \uC548 \uB3FC\uC694?"
  - iD: text_diag_000020_009
    speaker: choice
    dialogue: "...\uB098 \uCC38."
  - iD: text_diag_000020_010
    speaker: player
    dialogue: "\uC624\uB298\uB9CC\uC774\uB2E4."
  - iD: text_diag_000020_011
    speaker: student
    dialogue: "\uC5ED\uC2DC \uAC10\uB3C5\uB2D8 \uCD5C\uACE0!"
  - iD: text_diag_000020_012
    speaker: choice
    dialogue: "\uACF5\uBD80\uB3C4 \uC2E4\uB825\uC774\uB2E4."
  - iD: text_diag_000020_013
    speaker: player
    dialogue: "\uC5F4\uC2EC\uD788 \uD574\uB77C. \uBE60\uC9C8 \uC0DD\uAC01 \uB9D0\uACE0."
  - iD: text_diag_000020_014
    speaker: student
    dialogue: "\uC544...."
  - iD: text_diag_000020_015
    speaker: student
    dialogue: "\uAC10\uB3C5\uB2D8 \uC9C4\uC9DC \uB108\uBB34\uD574\uC694."
  - iD: text_diag_000020_016
    speaker: choice
    dialogue: "\uC548\uB3FC."
  - iD: text_diag_000020_017
    speaker: student
    dialogue: "\uB124..."
  - iD: text_diag_000020_018
    speaker: player
    dialogue: "\uADF8\uB7F0\uB370 \uC624\uB298 \uB9D0\uC774\uC9C0."
  - iD: text_diag_000020_019
    speaker: player
    dialogue: "\uB0B4\uAC00 \uB4B7\uBB38 \uC7A0\uADF8\uB294\uAC78"
  - iD: text_diag_000020_020
    speaker: player
    dialogue: "5\uBD84 \uC815\uB3C4 \uAE5C\uBE61 \uD560 \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0?"
  - iD: text_diag_000020_021
    speaker: student
    dialogue: ...!
  - iD: text_diag_000020_022
    speaker: student
    dialogue: "(\uC18C\uB9AC \uC548\uB098\uAC8C)"
  - iD: text_diag_000020_023
    speaker: student
    dialogue: "(\uC2AC\uB9AC\uD37C \uB4E4\uACE0 \uB6F0\uC5B4\uAC00\uACA0\uC2B5\uB2C8\uB2E4.)"
  - iD: text_diag_000020_024
    speaker: student
    dialogue: "(\uCDA9\uC131!)"
  - iD: text_diag_100000_000
    speaker: student
    dialogue: "\uD658\uC601\uD569\uB2C8\uB2E4, \uCF54\uCE58\uB2D8. \uC55E\uC73C\uB85C\uB3C4
      \uC798 \uBD80\uD0C1 \uB4DC\uB9BD\uB2C8\uB2E4."
  - iD: text_diag_100001_000
    speaker: student
    dialogue: "{target1.grade} {target1.name} \uD559\uC0DD\uC774 \uAE08\uC77C \uC9C0\uAC01\uD558\uC600\uC2B5\uB2C8\uB2E4.
      \uACC4\uB3C4 \uBD80\uD0C1 \uB4DC\uB9BD\uB2C8\uB2E4."
  - iD: text_diag_100002_000
    speaker: student
    dialogue: "\uAE08\uC77C \uCCB4\uC721\uAD00 \uC870\uBA85 \uAD50\uCCB4 \uC791\uC5C5\uC774
      \uC608\uC815\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uC18C\uC74C\uC774 \uBC1C\uC0DD\uD560
      \uC218 \uC788\uC73C\uB2C8 \uC591\uD574 \uBC14\uB78D\uB2C8\uB2E4."
  - iD: text_diag_110000_000
    speaker: student
    dialogue: "\uC18C\uC18D \uD559\uC0DD\uC758 \uBCD1\uACB0 \uC2E0\uACE0 \uB0B4\uC5ED\uC744
      \uB2E4\uC74C\uACFC \uAC19\uC774 \uC548\uB0B4\uB4DC\uB9BD\uB2C8\uB2E4.\\n\\n\uB300\uC0C1:
      \uB18D\uAD6C\uBD80 {target1.grade} {target1.name} \uD559\uC0DD\\n\uC0AC\uC720:
      \uC778\uD50C\uB8E8\uC5D4\uC790"
  - iD: text_diag_110001_000
    speaker: student
    dialogue: "\uC18C\uC18D \uD559\uC0DD\uC758 \uBCD1\uACB0 \uC2E0\uACE0 \uB0B4\uC5ED\uC744
      \uB2E4\uC74C\uACFC \uAC19\uC774 \uC548\uB0B4\uB4DC\uB9BD\uB2C8\uB2E4.\\n\\n\uB300\uC0C1:
      \uB18D\uAD6C\uBD80 {target1.grade} {target1.name} \uD559\uC0DD\\n\uC0AC\uC720:
      \uAE09\uC131 \uC7A5\uC5FC"
  - iD: text_diag_110002_000
    speaker: student
    dialogue: "\uC18C\uC18D \uD559\uC0DD\uC758 \uBCD1\uACB0 \uC2E0\uACE0 \uB0B4\uC5ED\uC744
      \uB2E4\uC74C\uACFC \uAC19\uC774 \uC548\uB0B4\uB4DC\uB9BD\uB2C8\uB2E4.\\n\\n\uB300\uC0C1:
      \uB18D\uAD6C\uBD80 {target1.grade} {target1.name} \uD559\uC0DD\\n\uC0AC\uC720:
      \uC6B0\uC6B8\uC99D"
  - iD: text_diag_111001_000
    speaker: student
    dialogue: "\uC18C\uC18D \uD559\uC0DD\uC758 \uC785\uC6D0 \uB0B4\uC5ED\uC744 \uB2E4\uC74C\uACFC
      \uAC19\uC774 \uC548\uB0B4\uB4DC\uB9BD\uB2C8\uB2E4.\\n\\n\uB300\uC0C1: \uB18D\uAD6C\uBD80
      {target1.grade} {target1.name} \uD559\uC0DD\\n\uC0AC\uC720: \uD0C0\uBC15\uC0C1"
  - iD: text_diag_111002_000
    speaker: student
    dialogue: "\uC18C\uC18D \uD559\uC0DD\uC758 \uC785\uC6D0 \uC2E0\uACE0 \uB0B4\uC5ED\uC744
      \uB2E4\uC74C\uACFC \uAC19\uC774 \uC548\uB0B4\uB4DC\uB9BD\uB2C8\uB2E4.\\n\\n\uB300\uC0C1:
      \uB18D\uAD6C\uBD80 {target1.grade} {target1.name} \uD559\uC0DD\\n\uC0AC\uC720:
      \uC6B4\uB3D9 \uC911 \uBC1C\uBAA9 \uC5FC\uC88C"
  - iD: text_diag_111003_000
    speaker: student
    dialogue: "\uC18C\uC18D \uD559\uC0DD\uC758 \uC785\uC6D0 \uC2E0\uACE0 \uB0B4\uC5ED\uC744
      \uB2E4\uC74C\uACFC \uAC19\uC774 \uC548\uB0B4\uB4DC\uB9BD\uB2C8\uB2E4.\\n\\n\uB300\uC0C1:
      \uB18D\uAD6C\uBD80 {target1.grade} {target1.name} \uD559\uC0DD\\n\uC0AC\uC720:
      \uC190\uAC00\uB77D \uC778\uB300 \uBD80\uC0C1"
  - iD: text_diag_111004_000
    speaker: student
    dialogue: "\uC18C\uC18D \uD559\uC0DD\uC758 \uC785\uC6D0 \uC2E0\uACE0 \uB0B4\uC5ED\uC744
      \uB2E4\uC74C\uACFC \uAC19\uC774 \uC548\uB0B4\uB4DC\uB9BD\uB2C8\uB2E4.\\n\\n\uB300\uC0C1:
      \uB18D\uAD6C\uBD80 {target1.grade} {target1.name} \uD559\uC0DD\\n\uC0AC\uC720:
      \uC2ED\uC790\uC778\uB300 \uBD80\uC0C1"
  - iD: text_diag_200001_000
    speaker: student
    dialogue: "\uC624\uB298 \uC624\uD6C4 \uBD80\uC2E4\uC5D0\uC11C \uAC04\uC2DD\uC744
      \uC81C\uACF5\uD558\uB2C8 \uD6C4\uBC30\uB4E4\uC740 \uBD80\uB2F4 \uC5C6\uC774
      \uCC38\uC11D \uBC14\uB78D\uB2C8\uB2E4.\\n- \uD55C\uC6B8\uACE0\uB4F1\uD559\uAD50
      3\uAE30 \uB18D\uAD6C\uBD80 \uC8FC\uC7A5 \uAE40 \uBC14\uC2A4\uCF13\uBCFC"
  - iD: text_diag_200002_000
    speaker: student
    dialogue: "\uB0B4\uC6A9: \uC9C0\uC5ED \uC544\uB3D9 \uC13C\uD130 \uC77C\uC77C
      \uB18D\uAD6C \uC7AC\uB2A5 \uAE30\uBD80\\n\uC8FC\uAD00: \uD55C\uC6B8\uB3D9 \uC8FC\uBBFC
      \uC790\uCE58 \uC704\uC6D0\uD68C\\n\\n\uBCF8\uAD50\uC758 \uAD50\uC721 \uAC00\uCE58\uB97C
      \uC2E4\uCC9C\uD574 \uC8FC\uC2E0 \uB18D\uAD6C\uBD80\uC5D0 \uAE4A\uC740 \uAC10\uC0AC\uB97C
      \uD45C\uD569\uB2C8\uB2E4."
