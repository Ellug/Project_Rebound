  - iD: text_diag_000010_000
    speaker: student
    dialogue: "\uC324 \uC601\uC5B4\uC324\uC774 \uB18D\uAD6C\uBD80 \uB2E4 \uB098\uC624\uB798\uC694"
  - iD: text_diag_000010_001
    speaker: player
    dialogue: "\uC65C? \uB610 \uC0AC\uACE0 \uCCE4\uB0D0?"
  - iD: text_diag_000010_002
    speaker: student
    dialogue: "NBA \uC601\uC0C1 \uBCF4\uBA74\uC11C \uB3C5\uD574\uD558\uB798\uC694;;
      \uBABB \uD558\uBA74 \uC9D1 \uBABB \uAC04\uB300\uC694"
  - iD: text_diag_000010_003
    speaker: choice
    dialogue: "\u314B\u314B\u314B \uC57C \uC774\uAC74 \uAE30\uD68C\uB2E4."
  - iD: text_diag_000010_004
    speaker: player
    dialogue: "\uC804\uC220 \uACF5\uBD80\uB3C4 \uD558\uACE0 \uC88B\uB124."
  - iD: text_diag_000010_005
    speaker: student
    dialogue: "\uD574\uC11D\uC774 \uC548 \uB418\uB294\uB370 \uBB34\uC2A8 \uC804\uC220\uC774\uC5D0\uC694\u3160\u3160"
  - iD: text_diag_000010_006
    speaker: player
    dialogue: "\uBAA8\uB974\uBA74 'Pass'\uB77C\uACE0 \uD574. \uB18D\uAD6C \uC6A9\uC5B4\uC796\uC544."
  - iD: text_diag_000010_007
    speaker: student
    dialogue: "\uC324 \uC9C4\uC9DC \uB3C4\uC6C0 1\uB3C4 \uC548 \uB3FC\uC694;;"
  - iD: text_diag_000010_008
    speaker: choice
    dialogue: "\uC5B4\uB514\uB0D0"
  - iD: text_diag_000010_009
    speaker: student
    dialogue: "\uB124?"
  - iD: text_diag_000010_010
    speaker: player
    dialogue: "\uAC10\uD788 \uC5F0\uC2B5\uC2DC\uAC04\uC744 \uBE8F\uC5B4?"
  - iD: text_diag_000010_011
    speaker: student
    dialogue: "...\uB124?"
  - iD: text_diag_000010_012
    speaker: player
    dialogue: "\uAE30\uB2E4\uB824\uB77C. \uB0B4\uAC00 \uAC04\uB2E4."
  - iD: text_diag_000010_013
    speaker: student
    dialogue: "(\uAC10\uB3D9)"
  - iD: text_diag_100000_000
    speaker: student
    dialogue: "\uD658\uC601\uD569\uB2C8\uB2E4, \uCF54\uCE58\uB2D8. \uC55E\uC73C\uB85C\uB3C4
      \uC798 \uBD80\uD0C1 \uB4DC\uB9BD\uB2C8\uB2E4."
  - iD: text_diag_200000_000
    speaker: student
    dialogue: "\u265A\u265A\uACBD\uC77C\u2606\uC544\uCE74\uB370\uBBF8\u265A\u265A\uAC00\uC785\uC2DC$$\uC804\uC6D0
