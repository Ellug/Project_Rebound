  - iD: text_diag_000001_024
    speaker: student
    dialogue: "...\uC774\uB9CC \uC57C\uC790 \uD558\uB7EC \uAC00\uBCF4\uACA0\uC2B5\uB2C8\uB2F7!"
  - iD: text_diag_000001_025
