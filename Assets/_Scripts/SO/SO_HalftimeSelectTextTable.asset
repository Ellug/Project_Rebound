  - id: name_match_choice_007
    description: "\uC774\uC628 \uC74C\uB8CC"
  - id: name_match_choice_008
    description: "\uAE34\uAE09 \uACF5\uC218"
  - id: name_match_choice_009
    description: "\uACFC\uAC10\uD55C \uACB0\uC815"
  - id: name_match_choice_010
    description: "\uB530\uBD09\uB3C4\uCE58"
  - id: description_match_choice_001
    description: "\uC0AD\uBC1C\uC744 \uAC01\uC624\uD55C \uD22C\uC9C0\uB97C \uBD88\uD0DC\uC6B4\uB2E4.\\n\uC288\uD305,
      \uC18D\uB3C4, \uC810\uD504\uB825\uC774 10 \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_002
    description: "\uC624\uB298\uC744 \uBC14\uCCD0 \uB0B4\uC77C\uC744 \uC7C1\uCDE8\uD55C\uB2E4.\\n\uC784\uC758\uC758
      \uC2A4\uD0EF\uC774 10% \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_003
    description: "\uC120\uC218\uB4E4\uC744 \uC751\uC6D0\uD560 \uC751\uC6D0\uB2E8\uC744
      \uACE0\uC6A9\uD55C\uB2E4.\\n\uC790\uAE08\uC774 5 \uAC10\uC18C\uD558\uACE0,
      \uC784\uC758\uC758 \uC2A4\uD0EF\uC774 15% \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_004
    description: "\uC2E4\uC2DC\uAC04\uC73C\uB85C \uC120\uC218\uC5D0\uAC8C \uD544\uC694\uD55C
      \uB0B4\uC6A9\uC744 \uAC00\uB974\uCE5C\uB2E4.\\n \uC288\uD305, \uC18D\uB3C4,
      \uC810\uD504\uB825\uC774 15 \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_005
    description: "\uACBD\uAE30 \uC2DC\uC791 \uC804 \uC2A4\uD2B8\uB808\uCE6D\uC73C\uB85C
      \uBAB8\uC744 \uD480\uC5B4\uC900\uB2E4.\\n \uC288\uD305, \uC18D\uB3C4, \uC810\uD504\uB825\uC774
      5 \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_006
    description: "\uD559\uC0DD\uB4E4\uC744 \uACA9\uB824\uD558\uC5EC \uC0AC\uAE30\uB97C
      \uB192\uD78C\uB2E4.\\n\uC9C0\uAD6C\uB825\uACFC \uCEE8\uB514\uC158\uC774 5 \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_007
    description: "\uC774\uC628\uC74C\uB8CC\uB85C \uCEE8\uB514\uC158\uC744 \uD68C\uBCF5\uD55C\uB2E4.\\n\uCEE8\uB514\uC158\uC774
      10 \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_008
    description: "\uAC13 \uC218\uD655\uD55C \uC2DC\uC6D0\uD55C \uC774\uC628\uC74C\uB8CC\uB85C
      \uCEE8\uB514\uC158\uACFC \uC9C0\uAD6C\uB825\uC744 \uD68C\uBD81\uD55C\uB2E4.\\n\uC790\uAE08\uC774
      10 \uAC10\uC18C\uD558\uACE0, \uC9C0\uAD6C\uB825\uACFC \uCEE8\uB514\uC158\uC774
      10 \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_009
    description: "\uAE09\uC9C4\uC801\uC778 \uC804\uB7B5 \uC804\uC220\uB85C \uC0C1\uB300\uC758
      \uBE48 \uD2C8\uC744 \uB178\uB9B0\uB2E4.\\n\uCEE8\uB514\uC158\uC774 5\uAC10\uC18C\uD558\uACE0,
      \uC288\uD305\uACFC \uC810\uD504\uB825\uC774 10 \uC99D\uAC00\uD55C\uB2E4."
  - id: description_match_choice_010
    description: "\uB530\uBD09\uB3C4\uCE58\uC57C \uACE0\uB9C8\uC6CC!\\n \uC784\uC758\uC758
      \uC2A4\uD0EF\uC774 20% \uC99D\uAC00\uD55C\uB2E4."
  - id: effect_description_match_choice_001
    description: "\uC288\uD305 +10, \uC18D\uB3C4 +10, \uC810\uD504\uB825 +10"
  - id: effect_description_match_choice_002
    description: "\uB79C\uB364 1\uAC1C \uC2A4\uD0EF +10%"
  - id: effect_description_match_choice_003
    description: "\uC790\uAE08 -5, \uB79C\uB364 1\uAC1C \uC2A4\uD0EF +15%"
  - id: effect_description_match_choice_004
    description: "\uC288\uD305 +15, \uC18D\uB3C4 +15, \uC810\uD504\uB825 +15"
  - id: effect_description_match_choice_005
    description: "\uC288\uD305 +5, \uC18D\uB3C4 +5, \uC810\uD504\uB825 +5"
  - id: effect_description_match_choice_006
    description: "\uC9C0\uAD6C\uB825 +5, \uCEE8\uB514\uC158 +5"
