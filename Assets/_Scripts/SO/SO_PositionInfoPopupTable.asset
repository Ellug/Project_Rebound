  m_Script: {fileID: 11500000, guid: 894c22a4bd05ceb428aa671f05c70a26, type: 3}
  m_Name: SO_PositionInfoPopupTable
  m_EditorClassIdentifier: Assembly-CSharp::PositionInfoPopupTableSO
  _rows:
  - id: pif_001
    titleText: "\uD3EC\uC9C0\uC158 \uC774\uB780?"
    desc: "\"\uD3EC\uC9C0\uC158\uC740 \uD300\uC758 \uC2B9\uB9AC\uB97C \uC704\uD574
      \uAC01 \uC120\uC218\uAC00 \uB9E1\uB294 \uACE0\uC720\uC758 \uC5ED\uD560\uC785\uB2C8\uB2E4.
      \uC2E0\uCCB4 \uC870\uAC74\uACFC \uAE30\uC220\uC801 \uAC15\uC810\uC5D0 \uB530\uB77C
      \uAC00\uB4DC, \uD3EC\uC6CC\uB4DC, \uC13C\uD130\uB85C \uB098\uB269\uB2C8\uB2E4.
      \uAC10\uB3C5\uC73C\uB85C\uC11C \uC120\uC218\uB4E4\uC758 \uD2B9\uC131\uC744
      \uD30C\uC545\uD558\uACE0 \uC801\uC7AC\uC801\uC18C\uC5D0 \uBC30\uCE58\uD558\uC5EC
      \uCD5C\uC0C1\uC758 \uC2DC\uB108\uC9C0\uB97C \uC774\uB04C\uC5B4\uB0B4\uC138\uC694.\""
  - id: pif_002
    titleText: "\uAC00\uB4DC"
    desc: "\"\uD300\uC758 \uACF5\uACA9\uC744 \uC124\uACC4\uD558\uB294 \uCF54\uD2B8
      \uC704\uC758 \uC0AC\uB839\uAD00\uC785\uB2C8\uB2E4. \uBE60\uB978 \uAE30\uB3D9\uB825\uACFC
      \uC815\uAD50\uD55C \uD578\uB4E4\uB9C1\uC73C\uB85C \uBCFC\uC744 \uC6B4\uBC18\uD558\uBA70,
      \uB113\uC740 \uC2DC\uC57C\uB97C \uD1B5\uD574 \uB3D9\uB8CC\uB4E4\uC5D0\uAC8C
      \uACB0\uC815\uC801\uC778 \uAE30\uD68C\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.
      \uC678\uACFD \uC29B\uACFC \uD328\uC2A4\uB85C \uACBD\uAE30\uB97C \uC870\uC728\uD558\uB294
      \uC5ED\uD560\uC744 \uC218\uD589\uD569\uB2C8\uB2E4.\""
  - id: pif_003
    titleText: "\uD3EC\uC6CC\uB4DC"
    desc: "\"\uB0B4\uC678\uACFD\uC744 \uC624\uAC00\uBA70 \uB4DD\uC810\uC744 \uC0DD\uC0B0\uD558\uB294
      \uACF5\uACA9\uC758 \uD575\uC2EC\uC785\uB2C8\uB2E4. \uB0A0\uCE74\uB85C\uC6B4
      \uB3CC\uD30C\uC640 \uC911\uAC70\uB9AC \uC29B\uC73C\uB85C \uC0C1\uB300 \uC218\uBE44\uB97C
      \uBB34\uB825\uD654\uD558\uBA70, \uB9AC\uBC14\uC6B4\uB4DC\uC5D0\uB3C4 \uC801\uADF9\uC801\uC73C\uB85C
      \uAC00\uB2F4\uD569\uB2C8\uB2E4. \uACF5\uC218 \uC591\uBA74\uC5D0\uC11C \uAC00\uC7A5
      \uB2E4\uC7AC\uB2E4\uB2A5\uD55C \uC6C0\uC9C1\uC784\uC744 \uBCF4\uC5EC\uC8FC\uB294
      \uD3EC\uC9C0\uC158\uC785\uB2C8\uB2E4.\""
  - id: pif_004
    titleText: "\uC13C\uD130"
    desc: "\"\uACE8\uBC11\uC744 \uC7A5\uC545\uD558\uB294 \uD300\uC758 \uB4E0\uB4E0\uD55C
      \uAE30\uB465\uC785\uB2C8\uB2E4. \uAC00\uC7A5 \uB192\uC740 \uC2E0\uC7A5\uACFC
      \uD798\uC744 \uD65C\uC6A9\uD574 \uC0C1\uB300 \uACF5\uACA9\uC744 \uCC28\uB2E8\uD558\uACE0
      \uB9AC\uBC14\uC6B4\uB4DC\uB97C \uD655\uBCF4\uD558\uC5EC \uACF5\uACA9\uAD8C\uC744
      \uC9C0\uCF1C\uB0C5\uB2C8\uB2E4. \uACE8\uBC11 \uC218\uBE44\uC640 \uD655\uC2E4\uD55C
      \uADFC\uAC70\uB9AC \uB4DD\uC810\uC744 \uCC45\uC784\uC9C0\uB294 \uCD5C\uD6C4\uC758
      \uBCF4\uB8E8\uC785\uB2C8\uB2E4.\""
